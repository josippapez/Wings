{
  "name": "wings-plugin-sdk",
  "version": "0.14.0",
  "description": "The wings API types, the page frame, React hooks and the build command for Wings plugins.",
  "license": "MIT",
  "type": "module",
  "types": "./wings.d.ts",
  "exports": {
    ".": {
      "types": "./wings.d.ts"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./shell": {
      "types": "./shell.d.ts",
      "default": "./shell.js"
    },
    "./poll": {
      "types": "./poll.d.ts",
      "default": "./poll.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "default": "./build.mjs"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "bin": {
    "wings-plugin": "bin.mjs"
  },
  "files": [
    "wings.d.ts",
    "react.js",
    "react.d.ts",
    "shell.js",
    "shell.d.ts",
    "poll.js",
    "poll.d.ts",
    "build.mjs",
    "build.d.ts",
    "bin.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josippapez/Wings.git",
    "directory": "packages/plugin-sdk"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~6.0.3"
  }
}
