{
  "name": "wings-plugin-sdk",
  "version": "0.1.0",
  "description": "Types, React hooks and a build command for Wings plugins.",
  "license": "MIT",
  "type": "module",
  "types": "./wings.d.ts",
  "exports": {
    ".": {
      "types": "./wings.d.ts"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "default": "./build.mjs"
    }
  },
  "bin": {
    "wings-plugin": "bin.mjs"
  },
  "files": [
    "wings.d.ts",
    "react.js",
    "react.d.ts",
    "build.mjs",
    "build.d.ts",
    "bin.mjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josippapez/Wings.git",
    "directory": "packages/plugin-sdk"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
