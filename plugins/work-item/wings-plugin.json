{
  "id": "work-item",
  "name": "Work item",
  "version": "0.5.0",
  "minWingsVersion": "0.1.24",
  "icon": "icon.svg",
  "description": "Shows the Azure Boards work item named in each pane's branch, like feature/1234-login, with its state, sprint and parent, and moves it to its next state. Also tells you when your work items change state, when a comment mentions you, and about activity on your pull requests. Opens a work item in a tab with its description, comments and linked pull requests, and lists the work items assigned to you in the current sprint under each project.",
  "api": 1,
  "main": "main.js",
  "permissions": {
    "exec": [
      "git remote get-url",
      "git branch --show-current",
      "az boards work-item show",
      "az boards work-item update [--id --state --organization -o]",
      "az boards query [--wiql --project --organization -o]",
      "az devops invoke",
      "az login"
    ],
    "openUrl": [
      "https://dev.azure.com/"
    ],
    "notify": true
  },
  "contributes": {
    "ui": [
      "badges"
    ],
    "views": [
      {
        "id": "updates",
        "title": "Updates",
        "page": "sidebar.html",
        "opens": [
          "sidebar",
          "tab"
        ],
        "newTab": true
      },
      {
        "id": "item",
        "title": "Work item",
        "icon": "kanban",
        "page": "item.html",
        "opens": [
          "tab"
        ],
        "multiple": true
      }
    ],
    "blocks": [
      {
        "id": "sprint",
        "title": "Sprint",
        "icon": "kanban",
        "page": "sprint.html",
        "minHeight": 160
      }
    ],
    "projectSections": [
      {
        "id": "work-items",
        "title": "Work items"
      }
    ],
    "settings": {
      "page": "settings.html"
    }
  }
}
