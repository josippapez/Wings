{
  "id": "work-item",
  "name": "Work item",
  "version": "0.9.2",
  "minWingsVersion": "0.1.50",
  "icon": "icon.svg",
  "description": "Shows the Azure Boards work item named in each pane's branch, like feature/1234-login, with its state, sprint and parent, and moves it to its next state. Opens a work item in a tab with its description, comments and linked pull requests, and lists the work items assigned to you in the current sprint under each project.",
  "api": 1,
  "main": "dist/main.js",
  "permissions": {
    "exec": [
      "git remote get-url",
      "git branch --show-current",
      "git rev-parse [--show-toplevel]",
      "git for-each-ref [--format]",
      "az boards work-item show",
      "az boards work-item update [--id --state --organization -o]",
      "az boards query [--wiql --project --organization -o]",
      "az devops invoke",
      "az login"
    ],
    "openUrl": [
      "https://dev.azure.com/"
    ]
  },
  "contributes": {
    "ui": [
      "badges"
    ],
    "views": [
      {
        "id": "item",
        "title": "Work item",
        "button": false,
        "icon": "kanban",
        "page": "dist/item.html",
        "opens": [
          "tab"
        ],
        "multiple": true
      }
    ],
    "blocks": [
      {
        "id": "sprint",
        "title": "Sprint",
        "icon": "kanban",
        "page": "dist/sprint.html",
        "minHeight": 160
      }
    ],
    "projectSections": [
      {
        "id": "work-items",
        "title": "Work items"
      }
    ]
  }
}
