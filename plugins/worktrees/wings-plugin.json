{
  "id": "worktrees",
  "name": "Worktrees",
  "version": "0.4.1",
  "minWingsVersion": "0.1.50",
  "icon": "icon.svg",
  "description": "Lists the git worktrees of your open projects with what each one is (merged, upstream gone, dirty, locked, missing folder), and removes the ones you no longer need after you confirm.",
  "api": 1,
  "main": "dist/main.js",
  "permissions": {
    "exec": [
      "git rev-parse [--show-toplevel --abbrev-ref --verify --quiet]",
      "git worktree list [--porcelain]",
      "git worktree remove [--]",
      "git worktree prune [--verbose]",
      "git status [--porcelain]",
      "git log [--max-count --format]",
      "git branch --list [--list --merged --format]",
      "git branch -d [-d]"
    ],
    "panes": []
  },
  "contributes": {
    "sidebars": [
      {
        "id": "worktrees",
        "title": "Worktrees",
        "page": "dist/sidebar.html"
      }
    ]
  }
}
