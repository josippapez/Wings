{
  "id": "hud",
  "name": "HUD",
  "version": "0.6.0",
  "minWingsVersion": "0.1.32",
  "icon": "icon.svg",
  "description": "Your Claude usage limits and each session's context and failed MCP servers in a strip under its terminal, and memory, MCP servers and skills in a sidebar, so you can turn off a terminal status line like claude-hud.",
  "api": 1,
  "main": "dist/main.js",
  "permissions": {
    "exec": [
      "vm_stat",
      "sysctl -n hw.memsize"
    ],
    "transcript": [
      "assistant",
      "user",
      "attachment:model",
      "attachment:deferred_tools_delta",
      "attachment:invoked_skills"
    ],
    "notify": true,
    "statusline": true
  },
  "contributes": {
    "ui": [
      "status"
    ],
    "sidebars": [
      {
        "id": "hud",
        "title": "HUD",
        "page": "dist/sidebar.html"
      }
    ]
  }
}
