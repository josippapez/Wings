{
  "id": "claude-chat",
  "name": "Claude chat",
  "version": "0.7.1",
  "minWingsVersion": "0.2.36",
  "description": "Experimental. Runs Claude Code as a chat in a tab instead of a terminal: messages, tool calls and permission prompts as cards, with Enter to send. Open a new chat from the + menu, or move a Claude terminal into one with its Chat badge.",
  "api": 1,
  "main": "dist/native/main.wasm",
  "permissions": {
    "exec": [
      "git ls-files [--cached --others --exclude-standard -z]",
      "git diff [--shortstat]",
      "git rev-parse [--abbrev-ref]",
      "claude plugin list [--available --json]",
      "claude plugin install [--json]"
    ],
    "processes": [
      "claude [-p --input-format --output-format --verbose --include-partial-messages --permission-prompt-tool --replay-user-messages --prompt-suggestions --resume]",
      "claude-rtk [-p --input-format --output-format --verbose --include-partial-messages --permission-prompt-tool --replay-user-messages --prompt-suggestions --resume]"
    ],
    "notify": true,
    "transcript": [
      "user",
      "assistant"
    ],
    "panes": [
      "claude --resume",
      "claude-rtk --resume"
    ]
  },
  "contributes": {
    "settings": {
      "page": "dist/native/settings.wasm"
    },
    "ui": [
      "agents",
      "badges"
    ],
    "projectSections": [
      {
        "id": "chats",
        "title": "Chats",
        "all": "chat"
      }
    ],
    "views": [
      {
        "id": "chat",
        "title": "Claude chat",
        "icon": "message",
        "page": "dist/native/chat.wasm",
        "opens": [
          "tab"
        ],
        "newTab": true,
        "multiple": true,
        "button": false
      }
    ]
  }
}
