{
  "id": "claude-chat",
  "name": "Claude chat",
  "version": "0.50.0",
  "minWingsVersion": "0.2.93",
  "description": "Experimental. Runs Claude Code as a chat in a tab instead of a terminal: messages, tool calls and permission prompts as cards, with Enter to send. Open a new chat from the + menu, or move a Claude terminal into one with its Chat badge.",
  "api": 1,
  "main": "dist/native/main.wasm",
  "permissions": {
    "statusline": true,
    "paneOutput": true,
    "claudeAccounts": true,
    "worktrees": true,
    "callTools": ["changes changed_files", "pr-tracker pull_request", "tasks get", "tasks list"],
    "events": ["changes review-comment"],
    "exec": [
      "git ls-files [--cached --others --exclude-standard -z]",
      "git diff [--shortstat]",
      "git rev-parse [--abbrev-ref]",
      "git for-each-ref [--format]",
      "git switch []",
      "claude plugin list [--available --json]",
      "claude plugin install [--json]",
      "claude --version [--version]",
      "claude upgrade []",
      "test [-d]",
      "cat []",
      "gh pr view [--json]",
      "gh pr merge [--squash --merge --rebase]",
      "gh issue list [--json --limit]",
      "az repos pr show [--id --organization --output]"
    ],
    "processes": [
      "claude [-p --input-format --output-format --verbose --include-partial-messages --permission-prompt-tool --replay-user-messages --prompt-suggestions --resume --fork-session --add-dir --include-hook-events --agent]",
      "claude-rtk [-p --input-format --output-format --verbose --include-partial-messages --permission-prompt-tool --replay-user-messages --prompt-suggestions --resume --fork-session --add-dir --include-hook-events --agent]",
      "claude edit-permission-rules [--json]",
      "claude edit-hook [--json]",
      "claude edit-skill-overrides [--json]",
      "claude edit-memory-settings [--json]"
    ],
    "fetch": [
      "GET https://downloads.claude.ai/claude-code-releases/latest"
    ],
    "notify": true,
    "openUrl": [
      "https://"
    ],
    "transcript": [
      "user",
      "assistant",
      "last-prompt",
      "attachment:queued_command",
      "ai-title",
      "custom-title"
    ],
    "panes": [
      "claude --resume",
      "claude-rtk --resume"
    ]
  },
  "contributes": {
    "hooks": ["UserPromptSubmit", "PreToolUse"],
    "settings": {
      "page": "dist/native/settings.wasm"
    },
    "ui": [
      "agents",
      "badges",
      "diff",
      "terminals"
    ],
    "projectSections": [
      {
        "id": "chats",
        "title": "Chats",
        "all": "chat"
      }
    ],
    "sidebars": [
      {
        "id": "subagent",
        "title": "Subagent",
        "icon": "message",
        "page": "dist/native/subagent.wasm",
        "button": false
      },
      {
        "id": "pane",
        "title": "Claude Code pane",
        "icon": "message",
        "page": "dist/native/pane.wasm",
        "button": false
      },
      {
        "id": "session",
        "title": "Claude session",
        "icon": "message",
        "page": "dist/native/session.wasm",
        "button": false
      }
    ],
    "views": [
      {
        "id": "chat",
        "title": "Claude chat",
        "icon": "message",
        "page": "dist/native/chat.wasm",
        "opens": [
          "tab"
        ],
        "newTab": true,
        "multiple": true,
        "resumes": [
          "claude"
        ]
      }
    ]
  }
}
