{
  "id": "pr-tracker",
  "name": "PR tracker",
  "version": "0.4.0",
  "description": "Shows the pull request for each pane's branch (GitHub, GitLab and Azure DevOps), with live status, checks, the diff and review comments.",
  "api": 1,
  "main": "main.js",
  "permissions": {
    "exec": [
      "git remote get-url",
      "git branch --show-current",
      "git rev-list",
      "git fetch",
      "git diff",
      "gh pr list",
      "gh pr view",
      "gh pr diff",
      "gh api",
      "gh auth login",
      "glab api",
      "glab mr diff",
      "glab auth status",
      "glab auth login",
      "az repos pr list",
      "az repos pr policy list",
      "az devops invoke",
      "az login"
    ],
    "post": [
      "gh repos/*/*/pulls/*/comments/*/replies",
      "glab projects/*/merge_requests/*/discussions/*/notes",
      "az https://dev.azure.com/*/*/_apis/git/repositories/*/pullRequests/*/threads/*/comments?api-version=7.1"
    ],
    "transcript": [
      "pr-link"
    ],
    "openUrl": [
      "https://github.com/",
      "https://gitlab.com/",
      "https://dev.azure.com/"
    ]
  },
  "contributes": {
    "ui": [
      "badges",
      "diff"
    ]
  }
}
