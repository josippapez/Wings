{
  "id": "session-detail",
  "name": "Session detail",
  "version": "0.7.1",
  "minWingsVersion": "0.1.104",
  "icon": "icon.svg",
  "description": "Shows what each Claude Code or OpenCode session is doing in a sidebar: its model and context size, recent tool calls, edited files with their diffs, and its to-do list.",
  "api": 1,
  "main": "dist/main.js",
  "permissions": {
    "agentActivity": true,
    "exec": [
      "git diff [-- --no-color --no-ext-diff]",
      "git ls-files [-- --error-unmatch]"
    ],
    "transcript": [
      "assistant",
      "user",
      "attachment:queued_command"
    ]
  },
  "contributes": {
    "ui": [
      "diff"
    ],
    "sidebars": [
      {
        "id": "activity",
        "title": "Session",
        "page": "dist/sidebar.html"
      }
    ]
  }
}
