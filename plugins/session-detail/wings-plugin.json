{
  "id": "session-detail",
  "name": "Session detail",
  "version": "0.3.1",
  "description": "Shows what each Claude session is doing: its model, context size, the tool it's running, and recent tool calls and edited files.",
  "api": 1,
  "main": "main.js",
  "permissions": {
    "transcript": [
      "assistant",
      "user",
      "attachment"
    ]
  },
  "contributes": {
    "ui": [
      "badges"
    ],
    "sidebars": [
      {
        "id": "activity",
        "title": "Session",
        "icon": "list",
        "page": "sidebar.html"
      }
    ]
  }
}
