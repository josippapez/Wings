{
  "id": "session-detail",
  "name": "Session detail",
  "version": "0.4.5",
  "minWingsVersion": "0.1.20",
  "icon": "icon.svg",
  "description": "Shows what each Claude session is doing: its model and context size, and recent tool calls, edited files with their diffs, and its to-do list.",
  "api": 1,
  "main": "main.js",
  "permissions": {
    "exec": [
      "git diff [-- --no-color --no-ext-diff]",
      "git ls-files [-- --error-unmatch]"
    ],
    "transcript": [
      "assistant",
      "user",
      "attachment"
    ]
  },
  "contributes": {
    "ui": [
      "badges",
      "diff"
    ],
    "sidebars": [
      {
        "id": "activity",
        "title": "Session",
        "page": "sidebar.html"
      }
    ]
  }
}
