{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "allow-spaces-list",
    "allow-spaces-add",
    "allow-spaces-remove",
    "allow-sessions-list",
    "allow-pane-create",
    "allow-pane-write",
    "allow-pane-resize",
    "allow-pane-close",
    "allow-panes-reset",
    "allow-pane-focus",
    "allow-agents-list",
    "allow-pane-info",
    "allow-git-status",
    "allow-git-refresh",
    "allow-workspace-load",
    "allow-workspace-save",
    "allow-plugins-list",
    "allow-plugin-install-file",
    "allow-plugin-install-github",
    "allow-plugin-update",
    "allow-plugin-latest-version",
    "allow-plugin-set-enabled",
    "allow-plugin-remove",
    "allow-plugin-panel-toggle",
    "allow-plugin-exec",
    "allow-plugin-transcript",
    "allow-plugin-statusline",
    "allow-plugin-open-url",
    "allow-plugin-open-pane",
    "allow-plugin-focus-pane",
    "allow-plugin-notify",
    "allow-bench-mode",
    "allow-bench-report",
    "allow-plugin-secret-set",
    "allow-plugin-secret-delete",
    "allow-plugin-secret-has",
    "allow-plugin-storage-get",
    "allow-plugin-storage-set",
    "allow-plugin-storage-delete",
    "allow-plugin-storage-keys",
    "allow-plugin-fetch",
    "allow-mcp-tool-result",
    "allow-mcp-status",
    "allow-mcp-connect",
    "allow-mcp-disconnect",
    "allow-cli-status",
    "allow-cli-install",
    "allow-cli-dismiss",
    "allow-history-search"
  ]
}
